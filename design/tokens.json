{
  "$schema": "VibeLauncher design tokens v1",
  "version": "1.0.0",
  "description": "Machine-readable design tokens for VibeLauncher (egui/eframe). Colors are #RRGGBB or #RRGGBBAA.",
  "color": {
    "light": {
      "bg": "#F6F7F9",
      "surface": "#FFFFFF",
      "surface-raised": "#FFFFFF",
      "surface-sunken": "#ECEEF2",
      "surface-hover": "#EEF0F4",
      "border": "#D5D9E0",
      "border-strong": "#7C8596",
      "text": "#14171F",
      "text-muted": "#4B5565",
      "text-disabled": "#8A93A3",
      "accent": "#4F46E5",
      "accent-hover": "#4338CA",
      "accent-active": "#3730A3",
      "on-accent": "#FFFFFF",
      "accent-subtle": "#E7E6FB",
      "focus-ring": "#4F46E5",
      "selection": "#C7C4F5",
      "success": "#166534",
      "warning": "#92400E",
      "danger": "#B91C1C",
      "info": "#1D4ED8",
      "on-danger": "#FFFFFF",
      "success-subtle": "#DDF3E4",
      "warning-subtle": "#FBEBD0",
      "danger-subtle": "#FBE0E0",
      "info-subtle": "#DEE7FB",
      "scrim": "#14171F99"
    },
    "dark": {
      "bg": "#0F1117",
      "surface": "#171A22",
      "surface-raised": "#1E222C",
      "surface-sunken": "#0B0D12",
      "surface-hover": "#222735",
      "border": "#2B3040",
      "border-strong": "#6B7488",
      "text": "#E8EAF0",
      "text-muted": "#A3ABBB",
      "text-disabled": "#6B7488",
      "accent": "#818CF8",
      "accent-hover": "#A5B4FC",
      "accent-active": "#7077F2",
      "on-accent": "#0F1117",
      "accent-subtle": "#262B4D",
      "focus-ring": "#A5B4FC",
      "selection": "#3A4180",
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "info": "#60A5FA",
      "on-danger": "#0F1117",
      "success-subtle": "#16301F",
      "warning-subtle": "#37290C",
      "danger-subtle": "#3A1717",
      "info-subtle": "#152642",
      "scrim": "#000000B3"
    }
  },
  "typography": {
    "family": {
      "sans": {
        "name": "Inter",
        "license": "OFL-1.1",
        "fallback": [
          "Noto Sans",
          "system-ui"
        ],
        "features": "Cyrillic, Latin"
      },
      "mono": {
        "name": "JetBrains Mono",
        "license": "OFL-1.1",
        "fallback": [
          "Noto Sans Mono",
          "monospace"
        ]
      },
      "icons": {
        "name": "Lucide",
        "license": "ISC"
      }
    },
    "size": {
      "caption": 11,
      "small": 12,
      "body": 14,
      "body-lg": 16,
      "heading-3": 18,
      "heading-2": 22,
      "heading-1": 28,
      "mono": 13
    },
    "line-height": {
      "caption": 16,
      "small": 18,
      "body": 20,
      "body-lg": 24,
      "heading-3": 24,
      "heading-2": 28,
      "heading-1": 34,
      "mono": 18
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "egui-text-style": {
      "Small": "small",
      "Body": "body",
      "Button": "body",
      "Heading": "heading-2",
      "Monospace": "mono"
    }
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 24,
      "6": 32,
      "7": 48,
      "8": 64
    },
    "item-spacing": [
      8,
      8
    ],
    "button-padding": [
      12,
      6
    ],
    "window-margin": 16,
    "card-padding": 16,
    "indent": 16
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 6,
    "lg": 10,
    "xl": 14,
    "full": 999
  },
  "size": {
    "control-height": 32,
    "control-height-lg": 40,
    "icon-sm": 16,
    "icon-md": 20,
    "icon-lg": 24,
    "instance-icon": 48,
    "instance-icon-lg": 64,
    "min-hit-target": 32,
    "sidebar-width": 220,
    "focus-ring-width": 2,
    "border-width": 1,
    "scrollbar-width": 8,
    "progress-height": 8
  },
  "shadow": {
    "light": {
      "sm": {
        "offset": [
          0,
          1
        ],
        "blur": 3,
        "spread": 0,
        "color": "#14171F1F"
      },
      "md": {
        "offset": [
          0,
          4
        ],
        "blur": 12,
        "spread": 0,
        "color": "#14171F26"
      },
      "lg": {
        "offset": [
          0,
          12
        ],
        "blur": 32,
        "spread": 0,
        "color": "#14171F33"
      }
    },
    "dark": {
      "sm": {
        "offset": [
          0,
          1
        ],
        "blur": 3,
        "spread": 0,
        "color": "#00000066"
      },
      "md": {
        "offset": [
          0,
          4
        ],
        "blur": 12,
        "spread": 0,
        "color": "#00000080"
      },
      "lg": {
        "offset": [
          0,
          12
        ],
        "blur": 32,
        "spread": 0,
        "color": "#000000A6"
      }
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 100,
      "base": 160,
      "slow": 240
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0,
        0,
        0,
        1
      ],
      "exit": [
        0.3,
        0,
        1,
        1
      ]
    },
    "reduced-motion": "durations become 0; progress shows static value; spinner replaced by text state"
  },
  "opacity": {
    "disabled": 0.5,
    "hover-overlay": 0.08,
    "pressed-overlay": 0.12
  },
  "icon": {
    "set": "Lucide",
    "license": "ISC",
    "stroke": 1.5,
    "grid": 24,
    "delivery": "icon font (lucide.ttf) as separate egui FontFamily, or SVG via egui_extras",
    "instance-icons": [
      "box",
      "cube",
      "sword",
      "pickaxe",
      "flask-conical",
      "leaf",
      "flame",
      "snowflake",
      "zap",
      "rocket",
      "gem",
      "compass",
      "map",
      "castle",
      "tree-pine",
      "ghost",
      "skull",
      "heart",
      "star",
      "wrench"
    ]
  }
}